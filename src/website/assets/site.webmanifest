{
  "name": "{{ .ctx.Site.Title }}",
  "short_name": "{{ .ctx.Site.Title }}",
  "icons": [
    {
      "src": "{{ .icon192 }}",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "{{ .icon512 }}",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "theme_color": "{{ .ctx.Site.Params.favicons.themeColor }}",
  "background_color": "{{ .ctx.Site.Params.favicons.backgroundColor }}",
  "display": "standalone"
}
